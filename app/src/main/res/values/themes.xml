<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Xtreme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/neon_purple</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Xtreme.Fullscreen" parent="Theme.Xtreme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
