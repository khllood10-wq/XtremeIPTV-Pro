<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- المحتوى الأساسي للتطبيق -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_deep">

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_card"
            app:itemIconTint="@color/neon_cyan"
            app:itemTextColor="@color/text_primary"
            app:itemActiveIndicatorStyle="@null"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>

    <!-- أيقونة السحب والفتح على اليمين -->
    <ImageView
        android:id="@+id/openDrawerBtn"
        android:layout_width="40dp"
        android:layout_height="60dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_search"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:tint="@color/neon_cyan"
        android:contentDescription="Settings"
        android:elevation="8dp"/>

    <!-- القائمة الجانبية (تنزلق من اليمين) -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/bg_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="30dp"
            android:text="Xtreme IPTV"
            android:textColor="@color/neon_cyan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/menu_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="⚙️ الإعدادات"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/menu_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="ℹ️ حول التطبيق"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="16dp"/>

        <TextView
            android:id="@+id/menu_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="🚪 تسجيل الخروج"
            android:textColor="@color/neon_pink"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground"/>

    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
